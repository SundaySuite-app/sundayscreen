{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SundayScreen",
  "version": "0.1.0-beta.1",
  "identifier": "app.sundaysuite.sundayscreen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1433",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SundayScreen",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1433"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "© 2026 Richard Fossland",
    "publisher": "Richard Fossland",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NjJCMTYxRTI5QUI5REQKUldUZHVacmlZYkZpUmRURVFPVEQ5L3RtMnkxZUNXWXIwcnhxdTFOaG5makU4K0JrVHhZV2Z3N0UK",
      "endpoints": [
        "https://updates.sundaysuite.app/v1/update/sundayscreen/stable"
      ]
    }
  }
}
